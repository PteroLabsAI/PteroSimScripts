<?xml version="1.0" encoding="UTF-8" ?>
<!-- Fast DDS under WSL2 mirrored networking: UDP to 127.0.0.1 crosses Windows and loses anything that
     fragments, so cap UDP messages below one packet; pterosim_cameras.py explains it. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_unfragmented</transport_id>
      <type>UDPv4</type>
      <!-- 1472 bytes is the largest UDP payload a 1500-byte MTU carries whole; chosen with headroom. -->
      <maxMessageSize>1400</maxMessageSize>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>shm</transport_id>
      <type>SHM</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="wsl_mirrored" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_unfragmented</transport_id>
        <transport_id>shm</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
